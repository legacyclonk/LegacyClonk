--- a/WindowsToolchain-0.14.0/Windows.MSVC.toolchain.cmake	2026-07-25 20:39:42.218954393 +0200
+++ b/WindowsToolchain-0.14.0/Windows.MSVC.toolchain.cmake	2026-07-25 20:50:20.652501721 +0200
@@ -86,6 +86,7 @@
     CMAKE_MT
     CMAKE_RC_COMPILER
     CMAKE_SYSTEM_PROCESSOR
+    VS_OVERRIDE_SYSTEM_PROCESSOR
     CMAKE_VS_PLATFORM_TOOLSET_HOST_ARCHITECTURE
     CMAKE_VS_PRODUCTS
     CMAKE_VS_VERSION_PRERELEASE
@@ -100,14 +101,24 @@
 
 include("${CMAKE_CURRENT_LIST_DIR}/VSWhere.cmake")
 
+if(VS_OVERRIDE_SYSTEM_PROCESSOR)
+    set(CMAKE_SYSTEM_PROCESSOR "${VS_OVERRIDE_SYSTEM_PROCESSOR}")
+endif()
+
 # If `CMAKE_SYSTEM_PROCESSOR` isn't set, default to `CMAKE_HOST_SYSTEM_PROCESSOR`
 if(NOT CMAKE_SYSTEM_PROCESSOR)
     set(CMAKE_SYSTEM_PROCESSOR ${CMAKE_HOST_SYSTEM_PROCESSOR})
 endif()
 
-# If `CMAKE_SYSTEM_PROCESSOR` is not equal to `CMAKE_HOST_SYSTEM_PROCESSOR`, this is cross-compilation.
+if(NOT VS_OVERRIDE_SYSTEM_PROCESSOR)
+    set(VS_OVERRIDE_SYSTEM_PROCESSOR "${CMAKE_SYSTEM_PROCESSOR}")
+endif()
+
+# Is this cross-compilation?
 # CMake expects `CMAKE_SYSTEM_NAME` to be set to reflect cross-compilation.
-if(NOT (CMAKE_SYSTEM_PROCESSOR STREQUAL ${CMAKE_HOST_SYSTEM_PROCESSOR}))
+if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows" OR # always if host is not Windows
+    (NOT CMAKE_SYSTEM_PROCESSOR STREQUAL ${CMAKE_HOST_SYSTEM_PROCESSOR}) AND # or if `CMAKE_SYSTEM_PROCESSOR` is not equal to `CMAKE_HOST_SYSTEM_PROCESSOR`
+        NOT (CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL "AMD64" AND CMAKE_SYSTEM_PROCESSOR STREQUAL "X86")) # but from AMD64 to x86 is not really cross-compiling
     set(CMAKE_SYSTEM_NAME Windows)
 endif()
 
